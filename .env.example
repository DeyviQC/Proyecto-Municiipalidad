APP_NAME="Sistema Registro Civil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Con Laravel Herd, el sitio "parkeado" queda disponible automáticamente en
# http://registro-civil.test (ajusta si usas otro nombre de carpeta).
APP_URL=http://registro-civil.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DBngin expone MySQL 9.7 en 127.0.0.1:3306 con root sin contraseña por defecto.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=registro_civil
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log

# Tamaño máximo permitido para PDFs subidos (KB)
ACTAS_PDF_MAX_KB=10240
